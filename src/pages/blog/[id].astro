---
import "../../styles/global.css";
import { Image } from "astro:assets";
import {
  sortItemsByDateDesc,
  createSlugFromTitle,
  withBase,
} from "../../utils/helpers";
import { type CollectionEntry, getCollection, render } from "astro:content";
import Button from "../../components/Button.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import ArrowLeft from "../../icons/ArrowLeft.astro";
import ArrowRight from "../../icons/ArrowRight.astro";
import siteConfig from "../../site.config";

export async function getStaticPaths() {
  const posts = (await getCollection("blogs")).sort(sortItemsByDateDesc);
  const postCount = posts.length;

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: index + 1 !== postCount ? posts[index + 1] : null,
      nextPost: index !== 0 ? posts[index - 1] : null,
    },
  }));
}

type Props = {
  post: CollectionEntry<"blogs">;
  prevPost: CollectionEntry<"blogs"> | null;
  nextPost: CollectionEntry<"blogs"> | null;
};

const { post, prevPost, nextPost } = Astro.props;
const { title, pubDate, author, tags = [], image, description } = post.data;
const { Content } = await render(post);
---

<MainLayout pageTitle={siteConfig.title + " | " + title}>
  <article class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6 sm:py-16">

    <!-- Article header -->
    <div class="mx-auto max-w-4xl text-center">

      {
        tags.length > 0 && (
          <div class="mb-5 flex flex-wrap justify-center gap-2">
            {tags.slice(0, 3).map((tag) => (
              <a
                href={withBase("/tags/" + createSlugFromTitle(tag))}
                class="rounded-full bg-space-red/10 px-3 py-1 text-xs font-semibold text-space-red transition-opacity hover:opacity-70 dark:bg-space-yellow/10 dark:text-space-yellow"
              >
                {tag}
              </a>
            ))}
          </div>
        )
      }

      <h1
        class="sigmar-ff mx-auto max-w-4xl text-balance text-4xl leading-tight sm:text-6xl"
      >
        {title}
      </h1>

      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm opacity-70">
        <span>By {author}</span>
        <span>•</span>
        <time datetime={new Date(pubDate).toISOString()}>
          {new Date(pubDate).toDateString()}
        </time>
      </div>

      {
        description && (
          <p class="mx-auto mt-6! max-w-2xl! text-balance text-base leading-relaxed opacity-70 sm:text-lg">
            {description}
          </p>
        )
      }
    </div>

    <!-- Featured image -->
    {
      image?.url && (
        <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-3xl shadow-2xl sm:mt-14">
          <Image
            class="h-auto w-full object-cover"
            src={image.url}
            alt={image.alt || title}
            width={1200}
            height={675}
          />
        </div>
      )
    }

    <!-- Article content -->
    <div
      class="article-content mx-auto mt-10 max-w-3xl text-left sm:mt-14"
    >
      <Content />
    </div>

    <!-- Tags -->
    {
      tags.length > 0 && (
        <div class="mx-auto mt-12 max-w-3xl border-t border-black/10 pt-6 dark:border-white/10">
          <span class="text-xs font-semibold uppercase tracking-widest opacity-50">
            Tags
          </span>

          <div class="mt-3 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={withBase("/tags/" + createSlugFromTitle(tag))}
                class="rounded-full border border-black/10 px-3 py-1 text-xs font-medium transition-colors hover:bg-space-red hover:text-white dark:border-white/10 dark:hover:bg-space-yellow dark:hover:text-black"
              >
                {tag}
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- Navigation -->
    <div class="mx-auto mt-12 flex max-w-3xl flex-col gap-4 border-t border-black/10 pt-8 dark:border-white/10 sm:flex-row sm:items-center sm:justify-between">

      <Button
        class="back-link"
        href={withBase("/blog")}
      >
        <ArrowLeft class="mr-3 h-5 w-5 fill-current" />
        All Stories
      </Button>

      {
        nextPost && (
          <Button
            class="back-link text-balance"
            href={withBase("/blog/" + nextPost.id)}
          >
            Next: {nextPost.data.title}
            <ArrowRight class="ml-3 h-5 w-5 fill-current" />
          </Button>
        )
      }

    </div>
  </article>
</MainLayout>