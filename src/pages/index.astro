---
import { getCollection } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import siteConfig from "../site.config";
import { sortItemsByDateDesc, withBase } from "../utils/helpers";
import PostCardPreview from "../components/PostCardPreview.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/Hero/ateliar-hero.jpg";
import ArrowRight from "../icons/ArrowRight.astro";

const allPosts = (await getCollection("blogs")).sort(sortItemsByDateDesc);
---

<MainLayout
  activePage="home"
 pageTitle={siteConfig.title + " | DIY, Tech, Gadgets & Creative Ideas"}
>
  <div
  class="jumbo-banner mx-auto my-10 flex w-full max-w-6xl flex-col gap-10 px-4 sm:my-16 sm:flex-row sm:items-center sm:justify-between"
>
  <div class="w-full sm:w-1/2">
    {
      siteConfig.hero?.eyebrowText && (
        <span class="mb-4 inline-block rounded-full border border-gray-400 px-4 py-1 text-xs font-medium tracking-wide opacity-80">
          {siteConfig.hero.eyebrowText}
        </span>
      )
    }

    <h1 class="sigmar-ff mb-5! text-balance text-4xl leading-tight sm:text-6xl">
      {siteConfig.hero?.title}
    </h1>

    <p
  class="kanit-regular max-w-xl text-balance text-base leading-relaxed opacity-75 sm:text-lg"
>
      {siteConfig.hero?.text}
    </p>

    <div class="mt-7 flex flex-wrap items-center gap-3">
      {
        siteConfig.hero?.actions?.map((action, index) => (
          <Button
            href={action.href}
            class={index === 0 ? "space-btn-filled" : "space-btn-outlined"}
          >
            {action.text}
          </Button>
        ))
      }
    </div>
  </div>

 <div class="w-full sm:w-1/2">
  <div class="relative mx-auto max-w-xl">
    <div
      class="absolute -inset-2 -z-10 rounded-[2rem] border border-space-red/20 opacity-60"
    ></div>

    <div class="overflow-hidden rounded-[2rem] shadow-2xl">
      <Image
        class="h-auto w-full object-cover transition-transform duration-500 hover:scale-105"
        src={heroImage}
        alt="Creative Ateliar workspace"
        width={800}
        height={600}
      />
    </div>
  </div>
</div>
</div>
  <div class="page-content mx-auto w-full max-w-7xl px-4 sm:px-6">
  <div class="mx-auto mb-10 w-full max-w-6xl rounded-3xl border border-black/10 bg-white/40 p-6 backdrop-blur-sm dark:border-white/10 dark:bg-white/5 sm:p-8">
  <div class="grid gap-6 sm:grid-cols-3 sm:items-center">
    <div class="sm:col-span-2">
      <span class="text-xs font-semibold uppercase tracking-[0.15em] opacity-60">
        Welcome to Ateliar
      </span>

      <h2 class="sigmar-ff mt-2! p-0! text-2xl sm:text-3xl">
        Ideas worth making.
      </h2>

      <p class="kanit-regular mt-3! mb-0! max-w-2xl text-sm leading-relaxed opacity-75 sm:text-base">
        Practical projects, useful technology, creative experiments and
        interesting things to explore — all in one place.
      </p>
    </div>

    <div class="sm:text-right">
      <a
        href={withBase("/about")}
        class="inline-flex items-center text-sm font-semibold text-space-red transition-transform duration-300 hover:translate-x-1 dark:text-space-yellow"
      >
        Learn more about Ateliar
        <span class="ml-2">→</span>
      </a>
    </div>
  </div>
</div>
    <div
  id="posts"
  class="flex w-full flex-col items-center justify-center py-8 sm:py-12"
>
      <div class="mb-8 flex w-full items-end justify-between">
  <div>
    <span class="text-xs font-semibold uppercase tracking-widest opacity-60">
      Latest
    </span>

    <h2 class="sigmar-ff mt-2! p-0! text-balance">
      Recent Stories
    </h2>
  </div>

  <a
    href={withBase("/blog")}
    class="hidden text-sm font-semibold opacity-70 transition-opacity hover:opacity-100 sm:block"
  >
    View all →
  </a>
</div>
      <div
  class="grid w-full max-w-6xl grid-cols-1 gap-6 text-left md:grid-cols-2 lg:grid-cols-3"
>
  {
    allPosts
      .slice(0, siteConfig.recentPostLimit)
      .map((post) => <PostCardPreview post={post} />)
  }
</div>
      <Button href={withBase("/blog")} class="space-btn-filled mt-8">
        View All Posts <ArrowRight class="w-5 h-5 fill-current ml-4" />
      </Button>
    </div>
  </div>
</MainLayout>
